# Future Frisbee - konfiguracja serwera Apache (kopiowana do dist/ przez scripts/build.mjs).
# Adres główny: https://futurefrisbee.pl (bez www).

AddDefaultCharset utf-8
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/xml .xml
</IfModule>

# ---------- Przekierowania 301 (jeden adres strony = lepsze SEO) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http → https (także za serwerem pośredniczącym, który ustawia X-Forwarded-Proto)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://futurefrisbee.pl%{REQUEST_URI} [L,R=301]

  # www → bez www
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://futurefrisbee.pl%{REQUEST_URI} [L,R=301]

  # /index.html → /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://futurefrisbee.pl/ [L,R=301]
</IfModule>

# ---------- Kompresja tekstu ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript image/svg+xml
</IfModule>

# ---------- Pamięć podręczna przeglądarki ----------
# Strony zawsze świeże; zdjęcia i ikony 30 dni (nazwy plików się nie zmieniają przy podmianie).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>

# ---------- Nagłówki bezpieczeństwa ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # HSTS: odkomentuj dopiero, gdy https://futurefrisbee.pl działa na pewno (przeglądarki zapamiętają to na rok).
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
